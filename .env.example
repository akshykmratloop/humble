# Copy to .env and fill in real values for local dev. Never commit .env.

NODE_ENV=development

# --- API ---
API_PORT=4000
SESSION_SECRET=change_me_dev_only_min_32_chars_______
CORS_ORIGIN=http://localhost:3000

# --- Database (packages/database, Prisma) ---
DATABASE_URL=postgresql://humble:humble_dev_only@localhost:5432/humble?schema=public

# --- Redis --- (docker-compose maps container 6379 -> host 6381; this machine's dev
# environment already has other projects' Redis containers on 6379/6380, so this repo
# claims 6381 to avoid clashing with them — adjust freely for your own machine)
REDIS_URL=redis://localhost:6381

# --- S3 (photos, moderation evidence) — leave blank locally to use disk fallback (dev-only) ---
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Stripe (post-MVP; leave blank until Slice 9) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
WEB_PORT=3000
